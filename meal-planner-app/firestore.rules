rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app uses one fixed household with metadata and separate meal/plan records.
    match /households/{householdId} {
      allow read, write: if householdId == 'default-household';

      match /{collectionName}/{recordId} {
        allow read, write: if householdId == 'default-household'
          && (collectionName == 'meals' || collectionName == 'plans');
      }
    }
  }
}
